<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Lumen" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@drawable/bg</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <style name="Lumen.Popup" parent="android:Theme.DeviceDefault.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.35</item>
        <item name="android:windowAnimationStyle">@style/Lumen.PanelAnim</item>
    </style>

    <style name="Lumen.PanelAnim" parent="">
        <item name="android:windowEnterAnimation">@anim/panel_in</item>
        <item name="android:windowExitAnimation">@anim/panel_out</item>
    </style>

    <style name="Lumen.MenuRow" parent="">
        <item name="android:background">@drawable/row_bg</item>
        <item name="android:textColor">@color/row_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Lumen.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/icon_button_bg</item>
        <item name="android:tint">@color/icon_button_tint</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="Lumen.Section" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.14</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
